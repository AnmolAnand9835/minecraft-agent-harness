# Google Gemini API key. Keep the actual key in .env; never commit it.
GEMINI_API_KEY=key_goes_here
# Optional alternative provider for Scout: DEEPSEEK_API_KEY=key_goes_here

# Copy the address and port shown by your Aternos server page.
MC_HOST=place yours
MC_PORT=place yours
MC_VERSION=auto
# Use offline only if the server owner explicitly configured offline-mode auth.
# Offline mode does not verify usernames; do not use it to bypass server access controls.
MC_AUTH=offline

AGENT_NAME=Scout
AGENT_MODEL=google/gemini-2.5-flash
AGENT_SANDBOX=none
